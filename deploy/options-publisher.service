[Unit]
Description=Publish dashboard state to Firebase Realtime Database
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/run_publisher.sh

Restart=always
RestartSec=15

# A reader, like the API. Enforce it rather than trust it: a bug that tries to
# write into data/ fails loudly instead of corrupting a Parquet part mid-soak.
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
Environment=PYTHONDONTWRITEBYTECODE=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=publisher

[Install]
WantedBy=multi-user.target
