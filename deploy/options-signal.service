[Unit]
Description=Daily option signal from the previous session's close
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/.venv/bin/python /home/ubuntu/signal.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal
