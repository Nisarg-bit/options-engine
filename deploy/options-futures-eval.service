[Unit]
Description=Stock-futures daily checks: reconciliation, data quality, metrics, research cadence (paper only; never activates a strategy)
After=network-online.target options-futures.service

# sf_daily.py: reconcile, validate data, measure, check compliance, detect drift,
# count the session toward the research cadence, pause entries on hard-risk failures.
# Strategy activation is NOT done here: it needs the user's approval (sf_approval.py).
# Publishes data/futures/eval/*.json. Idempotent per session.
# Exit 75 = feeds not complete yet: systemd retries every 20 minutes, at most 6
# times in 3 hours, then gives up until the next timer run (Persistent=true also
# catches up a run missed while the box was down).
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=-/home/ubuntu/.env
ExecStart=/home/ubuntu/.venv/bin/python sf_daily.py run
Restart=on-failure
RestartSec=20min
Nice=15
MemoryHigh=600M
MemoryMax=750M
OOMScoreAdjust=700
TimeoutStartSec=3h
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/data/futures
PrivateTmp=true
NoNewPrivileges=true
Environment=PYTHONDONTWRITEBYTECODE=1 MALLOC_ARENA_MAX=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=futures-eval

[Unit]
StartLimitIntervalSec=3h
StartLimitBurst=7
