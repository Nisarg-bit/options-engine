[Unit]
Description=Options engine Telegram command bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/run_bot.sh

Restart=always
RestartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=optionsbot

[Install]
WantedBy=multi-user.target
