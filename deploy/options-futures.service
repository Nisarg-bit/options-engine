[Unit]
Description=Stock-futures paper worker (seven agents, FUTSTK paper trading only)
After=network-online.target options-collector.service
Wants=network-online.target

# NOT INSTALLED. Template only: copy futures/*.py and futures/config/ next to the
# other modules, then install like the other units. Nothing here places an order.
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/run_futures.sh

Restart=always
RestartSec=15

# Reads the collector's data; writes only its own SQLite state and snapshot.
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/data/futures
PrivateTmp=true
NoNewPrivileges=true
Environment=PYTHONDONTWRITEBYTECODE=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=futures

[Install]
WantedBy=multi-user.target
