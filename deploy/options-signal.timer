[Unit]
Description=Generate the daily signal at 09:00 IST, before the open

[Timer]
# 03:30 UTC = 09:00 IST. Fifteen minutes after the collector's restart has
# refreshed the Kite token, and fifteen minutes before the market opens --
# enough time to read it and place an order by hand if you choose to.
OnCalendar=Mon-Fri *-*-* 03:30:00
# Deliberately NOT Persistent. A signal is only useful before the open; one
# fired late by a boot at 14:00 is noise pretending to be a trade.
Persistent=false

[Install]
WantedBy=timers.target
