[Unit]
Description=Stock-futures paper worker (seven agents, FUTSTK paper trading only)
After=network-online.target options-collector.service
Wants=network-online.target

# Installed by deploy/deploy-futures-live-2026-11-18.ps1. Paper trading only:
# nothing here places a broker order.
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/run_futures.sh

Restart=always
RestartSec=15

# The collector comes first on this 2 GB box. If memory runs short the kernel
# takes this worker, never the collector; it restarts and resumes from SQLite.
# Measured 18 Nov 2026 on a full synthetic day (220 stocks, both modes): peak ~190 MB.
MemoryHigh=230M
MemoryMax=320M
Environment=MALLOC_ARENA_MAX=2
OOMScoreAdjust=600
Nice=10
CPUQuota=60%

# Reads the collector's data; writes only its own SQLite state and snapshot.
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/data/futures
PrivateTmp=true
NoNewPrivileges=true
Environment=PYTHONDONTWRITEBYTECODE=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=futures

[Install]
WantedBy=multi-user.target
